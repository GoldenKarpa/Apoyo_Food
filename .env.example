# =========================================================
# Copy this file to .env.local for local dev (Next.js reads .env.local)
# AND to .env (the Prisma CLI only auto-loads .env, not .env.local).
# Copy to .env on the VPS for production.
#
# ⚠ This file must list EVERY process.env reference in the codebase. Salon
# shipped to production twice with a var missing from its runbook because the
# list was written from the plan instead of from the code. The authoritative
# inventory is:
#   grep -rn "process.env" app/ lib/ i18n/ middleware.ts next.config.ts
# =========================================================

# =========================================================
# Database (PostgreSQL) — Food owns its own DB (architecture Part C)
# =========================================================
# Local dev: docker-compose Postgres on host port 5434. Taken elsewhere on this
# machine: 5432 Beauty-Salon, 5433 Salon, 5435 Apparel.
# Prod DB is `apoyo_food` with its own role — see Slice 6. ⚠ Percent-encode any
# password containing URL-special characters (APOYO_ECOSYSTEM.md).
DATABASE_URL=postgresql://food:food_dev_password@localhost:5434/apoyo_food_dev

# =========================================================
# Assets — PROD ONLY. Prevents /_next collisions when this app is reached via
# portal.apoyolime.com/food/* (architecture Part B2 / F1). That host is shared
# with portal-web, the Apoyo-Demia app, salon-web and apparel-web. Leave unset
# in dev, where one origin serves both surfaces.
# =========================================================
# NEXT_PUBLIC_ASSET_HOST=https://food.apoyolime.com

# --- Everything below arrives with the slice named beside it. Listed now so the
# --- prod runbook is never assembled from memory. ---

# Slice 3 — shared identity. Food NEVER issues a session; it only validates the
# JWT cookie portal-web sets on .apoyolime.com (portal-web is the confirmed sole
# issuer). AUTH_SECRET must be byte-identical to portal-web's or every session
# decodes as signed-out.
# AUTH_SECRET=
# COOKIE_DOMAIN=.apoyolime.com

# Slice 3 — ecosystem API (memberships + the §6b registration-config toggle).
# ⚠ /memberships and /users/{id}/memberships are served by BOTH the Apoyo-Demia
# app and portal-web (same identity DB; portal's nginx path-split hides which
# answers). /config/registration is portal-web ONLY. The portal host covers all.
# ECOSYSTEM_API_BASE_URL=https://portal.apoyolime.com
# ⚠ Must be registered as a NEW, DISTINCT "food-app:<secret>" entry in the
# identity app's ECOSYSTEM_SERVICE_TOKENS. Never reuse salon-app's or
# apparel-app's — it would make the apps' calls indistinguishable in logs and
# couple their rotation.
# ECOSYSTEM_SERVICE_TOKEN=
# PORTAL_CLAIMS_SERVICE_TOKEN is deliberately NOT listed: Food pushes no
# TimeClaims in any phase of this plan (architecture Part B3). Add it only if a
# genuinely exclusive-time feature ever exists.

# Slice 4 — storage. Local disk behind lib/storage.ts, shaped so R2 swaps in as
# one module later. Prod must point OUTSIDE the git checkout so a redeploy can
# never touch already-written media.
# UPLOADS_BASE_PATH=
# MAX_UPLOAD_MB=10

# Slice 5 — the shared kap64-translate microservice (VPS-only by its own design;
# confirmed NOT reachable from local dev — see Apparel Slice 5's notes. The
# degrade path is the local default, not a scenario to stage).
# TRANSLATE_SERVICE_URL=http://localhost:5500
# TRANSLATE_API_KEY=
