// Apoyo Food — data model. `Apoyo_Food_Architecture.md` Part D is the authority
// for every field and enum here; names were polishable, shapes were not.
//
// Conventions, decided in Slice 2 and not to be re-litigated:
//  - **Casing follows Apoyo-Demia / portal-web**: `@map("snake_case")` columns,
//    `@@map("plural_snake_case")` tables. ⚠ Salon is the WRONG template — it has
//    zero @map in its entire schema. A later slice porting a Salon model
//    wholesale will import the wrong casing (Apparel Slice 2 finding).
//  - **IDs are `cuid()`** — shorter and URL-safer than uuid. Apparel's call, kept
//    for family consistency.
//  - **Money is INTEGER CENTS** (`priceCents`, `subtotalCents`), per Part D —
//    deliberately unlike Apparel's `Decimal(10,2)`, because Part D specifies
//    cents and the ordering maths is whole-cent arithmetic. Render only through
//    `lib/money.ts` (`formatCentsTtd`).
//  - **All `userId` / `clientId` / `senderUserId` fields are opaque identity-store
//    strings with NO relation** — the identity DB is a different database
//    (architecture Part C). Never add a cross-DB FK.
//  - **Timestamps are `timestamptz`** (Prisma `DateTime` on Postgres). Pure
//    calendar dates that carry no time-of-day meaning use `@db.Date` instead, so
//    "available from the 1st" can't drift by a timezone offset.
//  - Several invariants live in hand-written CHECK constraints in the migration
//    rather than here — Prisma models none of them, which is exactly what makes
//    them safe to add there (schema diffing never proposes dropping them). See
//    the migration's header comment for the full list and its reasoning.
//
// Deliberately NOT created yet (architecture Part D "later-phase entities", and
// BUILD_SLICES.md Slice 2's own instruction): `FoodCollection`/`FoodCollectionItem`
// (Phase 4), `FoodListingStats` (Phase 5), `FoodReview` (Phase 7),
// `FoodCustomerRequest`/`FoodRequestResponse` (Phase 8), `FoodSellerVerification`
// (Phase 9). Their enums are omitted too: zero real users means those migrations
// are free later, and an enum type with no table reading it is noise, not
// foresight. The one thing this schema DOES pre-build for a later phase is
// `FoodSeller.lat`/`lng` — Part C requires those columns from day one so
// geocoding is additive rather than a migration of meaning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

/// Copied VERBATIM from Salon (architecture Part B2) — reusing the same eight
/// values keeps a seller's declared areas consistent if they are active across
/// verticals, and Apparel reuses them too.
enum RegionKey {
  north_west
  east_west_corridor
  central
  south_central
  south_west
  north_east
  south_east
  tobago

  @@map("region_key")
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED

  @@map("seller_status")
}

/// Part D: covers Idea.md's selling models without privileging one. Holiday
/// specials / limited-time offers are ORTHOGONAL to this — any kind plus a
/// DATE_RANGE window plus an optional `occasionTag`.
enum ListingKind {
  SINGLE_ITEM
  MENU
  PACKAGE
  TRAY
  CUSTOM

  @@map("listing_kind")
}

enum PriceMode {
  FIXED
  STARTING_AT
  QUOTE

  @@map("price_mode")
}

enum AvailabilityType {
  PREORDER
  RECURRING_WEEKLY
  DATE_RANGE

  @@map("availability_type")
}

enum FulfillmentMode {
  PICKUP
  SELLER_DELIVERY
  MEETUP

  @@map("fulfillment_mode")
}

/// Part D / E5: PENDING -> ACCEPTED -> COMPLETED, with four terminal
/// alternatives. Transitions are guarded in application code (Slice 17).
enum OrderStatus {
  PENDING
  ACCEPTED
  COMPLETED
  DECLINED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_SELLER
  EXPIRED

  @@map("order_status")
}

enum DemandEventKind {
  SEARCH
  LISTING_VIEW
  PROFILE_VIEW
  SAVE
  FOLLOW
  ORDER_PLACED
  STORY_VIEW

  @@map("demand_event_kind")
}

/// Part D marks this extensible — add values as notification kinds ship rather
/// than repurposing an existing one.
enum NotificationKind {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_DECLINED
  ORDER_EXPIRED
  ORDER_CANCELLED
  ORDER_COMPLETED
  ORDER_MESSAGE
  ORDER_REMINDER
  NEW_FOLLOWER
  STORY_FROM_FOLLOWED

  @@map("notification_kind")
}

/// Order-thread attachments. Part D names only PHOTO; video is out of scope for
/// this plan entirely.
enum AttachmentKind {
  PHOTO

  @@map("attachment_kind")
}

/// Slice 16 report/flag intake. Trinidad-appropriate reasons for a home-kitchen
/// marketplace — `FOOD_SAFETY_CONCERN` replaces Apparel's `WRONG_CATEGORY`,
/// which has no equivalent stakes here (Part G).
enum ReportReason {
  INAPPROPRIATE
  SUSPECTED_SCAM
  FOOD_SAFETY_CONCERN
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("report_status")
}

// ============================================================================
// Core entities
// ============================================================================

model FoodSeller {
  id String @id @default(cuid())

  /// Opaque identity-store user id — no cross-DB relation (see header).
  userId      String  @unique @map("user_id")
  slug        String  @unique
  displayName String  @map("display_name")
  bio         String?

  /// Slice 18 schema reconciliation — transactional email (order lifecycle,
  /// thread messages) needs an address, but the ecosystem API contract
  /// exposes no users-lookup-by-id endpoint (confirmed against
  /// `Apoyo_Provider_API_Contract.md`) and a sweep-driven send (expiry,
  /// completion nudges) has no live session to read one from at that point.
  /// Captured ONCE at onboarding submit from the session that IS available
  /// then (`lib/actions/onboard-seller.ts`) — the exact snapshot pattern
  /// Salon's own `SalonProvider.email` uses for the identical gap. Nullable:
  /// the JWT's email claim is technically optional, and rows created before
  /// this column existed have none.
  email String? @map("email")

  /// Media variant sets produced by the Slice 4 pipeline (thumb/card/full +
  /// base64 LQIP). Nullable because Slice 13's onboarding is explicitly
  /// skippable-and-resumable — a NOT NULL column here would block a seller from
  /// existing before they have chosen a photo.
  profileImageThumb String? @map("profile_image_thumb")
  profileImageCard  String? @map("profile_image_card")
  profileImageFull  String? @map("profile_image_full")
  profileImageBlur  String? @map("profile_image_blur")
  coverImageThumb   String? @map("cover_image_thumb")
  coverImageCard    String? @map("cover_image_card")
  coverImageFull    String? @map("cover_image_full")
  coverImageBlur    String? @map("cover_image_blur")

  /// 1–3 service areas (Part C). The DB enforces the UPPER bound only — see the
  /// migration's `food_sellers_areas_max_three`. "At least one" is an
  /// activation-time rule, not a row-creation rule, because onboarding is
  /// resumable and a PENDING seller may legitimately have none yet.
  areas RegionKey[]

  /// Phase 9 geocoding, present from day one so "nearby" can swap area-match for
  /// distance sort without a migration of meaning (Part C).
  lat Float?
  lng Float?

  languages        String[]
  specialties      String[]
  status           SellerStatus      @default(PENDING)
  fulfillmentModes FulfillmentMode[] @map("fulfillment_modes")

  /// Denormalised counter, maintained alongside FoodFollow writes (Slice 11).
  followerCount Int @default(0) @map("follower_count")

  /// Recent-activity signal for the Fresh Today rail's ordering. Part E2 is
  /// explicit that this is a plain column, NOT a FoodDemandEvent — posting is
  /// presence, not demand.
  lastStoryAt DateTime? @map("last_story_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  photos     FoodSellerPhoto[]
  listings   FoodListing[]
  stories    FoodStory[]
  highlights FoodStoryHighlight[]
  followers  FoodFollow[]
  orders     FoodOrder[]
  reports    FoodReport[]

  @@index([status])
  @@index([status, lastStoryAt])
  /// GIN over the enum array so area filtering ("sellers near you", the region
  /// map browse) stays indexable as seller count grows.
  @@index([areas(ops: ArrayOps)], type: Gin)
  @@map("food_sellers")
}

model FoodSellerPhoto {
  id       String @id @default(cuid())
  sellerId String @map("seller_id")

  pathThumb   String  @map("path_thumb")
  pathCard    String  @map("path_card")
  pathFull    String  @map("path_full")
  blurDataUrl String  @map("blur_data_url")
  caption     String?
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  seller FoodSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, sortOrder])
  @@map("food_seller_photos")
}

/// Seeded taxonomy, admin-extendable (Slice 16's category manager). Part D's
/// seed list is a starting set — open question 4 leaves Trini-specific additions
/// to community input, which is exactly why this is a table and not an enum.
model FoodCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameEn      String  @map("name_en")
  nameEs      String  @map("name_es")
  heroImage   String? @map("hero_image")
  sortOrder   Int     @default(0) @map("sort_order")
  seasonal    Boolean @default(false)
  occasionTag String? @map("occasion_tag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listings FoodListingCategory[]

  @@index([sortOrder])
  @@map("food_categories")
}

model FoodListing {
  id       String @id @default(cuid())
  sellerId String @map("seller_id")

  /// Globally unique — `/meals/[slug]` is a root-level route (architecture F1),
  /// not nested under the seller. Collision-suffixed generation is Slice 14.
  slug        String @unique
  title       String
  description String

  kind       ListingKind
  priceMode  PriceMode   @map("price_mode")
  /// Integer TTD cents. NULL is legal only for QUOTE listings — enforced by
  /// `food_listings_price_by_mode` in the migration.
  priceCents Int?        @map("price_cents")
  feedsCount Int?        @map("feeds_count")

  dietaryTags    String[] @map("dietary_tags")
  /// Search fuel (Part E3) — matched by trigram/tsvector alongside the title.
  ingredientTags String[] @map("ingredient_tags")
  occasionTag    String?  @map("occasion_tag")

  active Boolean @default(true)

  /// Admin-authority removal (Slice 16), distinct from the seller's own
  /// `active` pause switch. Set only by `takedownListing`; `DISCOVERABLE`
  /// requires it null, and the seller's own `toggleListingActive` refuses to
  /// flip `active` back on while it is set — otherwise "takedown" would mean
  /// nothing, since the seller could just undo it themselves.
  takenDownAt DateTime? @map("taken_down_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller              FoodSeller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  photos              FoodListingPhoto[]
  categories          FoodListingCategory[]
  availabilityWindows FoodAvailabilityWindow[]
  saves               FoodSave[]
  orderItems          FoodOrderItem[]
  linkedStories       FoodStory[]
  reports             FoodReport[]

  @@index([sellerId, active])
  @@index([active, createdAt])
  @@map("food_listings")
}

model FoodListingPhoto {
  id        String @id @default(cuid())
  listingId String @map("listing_id")

  pathThumb   String  @map("path_thumb")
  pathCard    String  @map("path_card")
  pathFull    String  @map("path_full")
  blurDataUrl String  @map("blur_data_url")
  caption     String?
  /// Position 0 is the hero image (Part D: "ordered, first = hero").
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("food_listing_photos")
}

model FoodListingCategory {
  listingId  String @map("listing_id")
  categoryId String @map("category_id")

  listing  FoodListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
  @@index([categoryId])
  @@map("food_listing_categories")
}

/// Multiple windows per listing. ⚠ Part D is emphatic that "available today /
/// this weekend" badges and filters are COMPUTED from these windows and are
/// never a live-inventory flag — that is the anti-waste stance, expressed
/// structurally. `lib/availability.ts` (Slice 14) owns that computation.
model FoodAvailabilityWindow {
  id        String @id @default(cuid())
  listingId String @map("listing_id")

  type AvailabilityType

  /// RECURRING_WEEKLY: 7-bit mask, bit 0 = Sunday .. bit 6 = Saturday (1..127).
  daysOfWeek   Int?      @map("days_of_week")
  /// DATE_RANGE: pure calendar dates in America/Port_of_Spain — `@db.Date`, not
  /// timestamptz, so a range boundary cannot drift by a UTC offset.
  startsOn     DateTime? @map("starts_on") @db.Date
  endsOn       DateTime? @map("ends_on") @db.Date
  /// PREORDER: how many days ahead an order must be placed.
  leadTimeDays Int?      @map("lead_time_days")

  /// Free text, e.g. "orders close 4pm Friday".
  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([type])
  @@map("food_availability_windows")
}

// ============================================================================
// Engagement entities
// ============================================================================
//
// ⚠ NAMING (architecture Part E2, decided 2026-07-30): these models keep their
// `FoodStory*` names — "story" is an accurate generic technical description of
// ephemeral timestamped content, and renaming would be pure churn. Everything
// USER-FACING is the "Fresh Today" board / "Menu shelf", and the components are
// named `<FreshTodayRail>` / `<FreshTodayCard>` / `<FreshTodayViewer>` /
// `<MenuShelf>` accordingly. Do not "fix" one side to match the other.

model FoodStory {
  id       String @id @default(cuid())
  sellerId String @map("seller_id")

  pathThumb   String  @map("path_thumb")
  pathCard    String  @map("path_card")
  pathFull    String  @map("path_full")
  blurDataUrl String  @map("blur_data_url")
  caption     String?

  /// Optional tap-through to a listing — the "fresh cookies just finished" ->
  /// order path. SetNull rather than Cascade: a removed listing must not take
  /// the post with it.
  linkedListingId String? @map("linked_listing_id")

  createdAt   DateTime @default(now()) @map("created_at")
  /// createdAt + 24h (open question 5: provisional lifetime). Enforced > createdAt
  /// by `food_stories_expires_after_created`. The `food-sweep` job (Slice 15)
  /// clears expired rows.
  expiresAt   DateTime @map("expires_at")
  /// NULL = ephemeral; set = kept on the profile's Menu shelf.
  highlightId String?  @map("highlight_id")

  seller        FoodSeller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  linkedListing FoodListing?        @relation(fields: [linkedListingId], references: [id], onDelete: SetNull)
  highlight     FoodStoryHighlight? @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  views         FoodStoryView[]

  @@index([sellerId, createdAt])
  @@index([expiresAt])
  @@index([highlightId])
  @@map("food_stories")
}

/// Named groups on the profile, presented as the "Menu shelf" — labelled
/// rectangular cards ("Especialidades", "Festivos"), never IG highlight circles.
model FoodStoryHighlight {
  id       String @id @default(cuid())
  sellerId String @map("seller_id")

  title      String
  coverImage String? @map("cover_image")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller  FoodSeller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  stories FoodStory[]

  @@index([sellerId, sortOrder])
  @@map("food_story_highlights")
}

/// Powers the seen/unseen card-border treatment and gives sellers a simple reach
/// number. Opaque `userId`, so an anonymous viewer records nothing.
model FoodStoryView {
  id      String @id @default(cuid())
  storyId String @map("story_id")
  userId  String @map("user_id")

  viewedAt DateTime @default(now()) @map("viewed_at")

  story FoodStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId, viewedAt])
  @@map("food_story_views")
}

model FoodFollow {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  sellerId String @map("seller_id")

  createdAt DateTime @default(now()) @map("created_at")

  seller FoodSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerId])
  @@index([sellerId, createdAt])
  @@index([userId, createdAt])
  @@map("food_follows")
}

/// The one-tap heart (Slice 10). Named collections are Phase 4 and attach to
/// these rows rather than replacing them.
model FoodSave {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  listingId String @map("listing_id")

  createdAt DateTime @default(now()) @map("created_at")

  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@map("food_saves")
}

// ============================================================================
// Ordering entities
// ============================================================================

/// ⚠ Food pushes NO `TimeClaim`s in any phase of this plan (architecture Part
/// B3) — a Food order is not an exclusive-time appointment, so there is nothing
/// for the cross-vertical double-booking block to protect. `fulfillmentAt` is
/// the documented seam if a genuinely exclusive offering (catering service,
/// cooking class) ever needs to claim time through the portal.
model FoodOrder {
  id String @id @default(cuid())

  /// Short human code, e.g. "FD-4821" — what both parties quote to each other.
  orderNumber String @unique @map("order_number")

  /// Opaque identity-store id of the customer; no relation (see header).
  clientId String @map("client_id")
  sellerId String @map("seller_id")

  /// Slice 18 schema reconciliation — same identity-lookup gap as
  /// `FoodSeller.email`, snapshotted at the SAME moment for the SAME reason:
  /// order lifecycle email (accepted/declined/expired) and the message-thread
  /// digest fire well after the request, often from a sweep with no live
  /// client session (`createOrderRequest`, Slice 17, now writes this).
  clientEmail String? @map("client_email")

  status                OrderStatus     @default(PENDING)
  fulfillmentMode       FulfillmentMode @map("fulfillment_mode")
  /// Requested date/time, stored UTC and displayed in America/Port_of_Spain.
  fulfillmentAt         DateTime        @map("fulfillment_at")
  /// ⚠ Meet-up point / delivery area as FREE TEXT ONLY. Exact addresses are
  /// exchanged in the order thread AFTER acceptance and are never stored on a
  /// public surface (architecture Part G — pickup means a customer visiting a
  /// home kitchen).
  fulfillmentAreaOrNote String?         @map("fulfillment_area_or_note")

  /// NULL until a seller prices QUOTE items. At acceptance this is the AGREED
  /// price — the platform records it for both parties' history and later seller
  /// analytics, and never touches money (cash/offline settlement).
  subtotalCents Int?    @map("subtotal_cents")
  customerNote  String? @map("customer_note")

  /// Auto-expiry deadline for PENDING (default 24h — open question 5,
  /// provisional). The sweep marks EXPIRED past this; a request must never die
  /// silently (Part E5).
  respondBy DateTime @map("respond_by")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiredAt   DateTime? @map("expired_at")

  declineReason      String? @map("decline_reason")
  cancellationReason String? @map("cancellation_reason")

  /// Restrict, not Cascade: an order is append-only evidence of a real-world
  /// transaction for BOTH parties. A seller row that has orders cannot be hard
  /// deleted — `SellerStatus.SUSPENDED` exists for that.
  seller   FoodSeller         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items    FoodOrderItem[]
  messages FoodOrderMessage[]

  @@index([sellerId, status, createdAt])
  @@index([clientId, createdAt])
  @@index([status, respondBy])
  @@index([status, fulfillmentAt])
  @@map("food_orders")
}

model FoodOrderItem {
  id        String @id @default(cuid())
  orderId   String @map("order_id")
  listingId String @map("listing_id")

  /// Snapshots make order history immune to later listing edits (Part D).
  titleSnapshot      String @map("title_snapshot")
  priceCentsSnapshot Int?   @map("price_cents_snapshot")

  quantity Int     @default(1)
  note     String?

  order   FoodOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict for the same reason as FoodOrder.seller — the snapshot protects
  /// history from EDITS, this protects it from DELETION.
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([listingId])
  @@map("food_order_items")
}

/// One thread per order — no separate thread entity is needed in MVP. Transport
/// is fetch-on-load + light polling now; the Phase-9 ws upgrade reuses this
/// exact table with no schema change (architecture Part C).
model FoodOrderMessage {
  id      String @id @default(cuid())
  orderId String @map("order_id")

  /// Opaque identity-store id; either party.
  senderUserId String @map("sender_user_id")

  /// Salon's locked message shape: the original is stored as authored, and
  /// translations are computed ONCE at send time via kap64-translate and stored
  /// here as { locale: text }. Never recomputed on read.
  originalText   String @map("original_text")
  originalLocale String @map("original_locale")
  translations   Json   @default("{}")

  attachmentPath String?         @map("attachment_path")
  attachmentKind AttachmentKind? @map("attachment_kind")

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  order FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("food_order_messages")
}

/// Buyer-facing report/flag intake (Slice 16), mirroring Apparel's
/// `ApparelReport` shape. Anonymous-safe: `reporterUserId` is nullable because
/// an anonymous reporter has no stable identity to attach, and the mitigation
/// for spam is content-scoped (at most one OPEN report per listing) rather
/// than identity-scoped (`lib/actions/report-listing.ts`).
model FoodReport {
  id String @id @default(cuid())

  listingId      String? @map("listing_id")
  sellerId       String  @map("seller_id")
  reporterUserId String? @map("reporter_user_id")

  reason  ReportReason
  message String?      @db.Text
  status  ReportStatus @default(OPEN)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  /// SetNull, not Cascade: a report is evidence about the SELLER even if the
  /// specific listing it named is later removed.
  listing FoodListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Restrict, same reasoning as `FoodOrder.seller` — a seller with an
  /// unresolved report is not hard-deletable through any path this app has.
  seller  FoodSeller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([sellerId])
  @@map("food_reports")
}

// ============================================================================
// Platform entities
// ============================================================================

/// Slice 17: the pre-launch "Coming Soon" gate for real ordering — a single
/// admin-toggled row (`id = "singleton"`), not a code-level flag. The user's
/// own instruction: ordering ships fully built but administratively PAUSED
/// until `/food/admin`'s "Ordering" section is switched on, so a demo can go
/// live long before the underlying feature is ready to take real requests.
///
/// ⚠ A MISSING row means DISABLED — `lib/platform-settings.ts`'s
/// `getOrderingEnabled()` treats `null` the same as `orderingEnabled: false`.
/// That is what makes the feature ship default-OFF (the desired launch state)
/// without a seed step: the row is created lazily, on the first admin toggle.
model FoodPlatformSetting {
  id              String   @id @default("singleton")
  orderingEnabled Boolean  @default(false) @map("ordering_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("food_platform_settings")
}

/// In-app inbox plus the email fan-out marker. `emailedAt` is what makes the
/// Resend fan-out idempotent and crash-safe (Part E6).
model FoodNotification {
  id     String           @id @default(cuid())
  userId String           @map("user_id")
  kind   NotificationKind

  /// Ids/titles needed to render the row without re-querying the world.
  payload Json @default("{}")

  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@index([kind, emailedAt])
  @@map("food_notifications")
}

/// Append-only demand stream. ⚠ Logging starts the moment browse ships (Slice 9),
/// NOT when the insights UI ships in Phase 6 — events are cheap to log and
/// literally impossible to backfill (architecture Part C).
///
/// ⚠ This model has NO relations at all, unlike every other table here, and that
/// is deliberate: it is the highest-write table in the app, and its rows must
/// outlive the listing or seller they describe. An event that vanishes when a
/// listing is removed is worthless as history. The id columns below are soft,
/// unenforced references (Apparel Slice 2 precedent).
///
/// Privacy (Part G / E7): only a salted `userIdHash` ever lands here, never a raw
/// identity, and every published aggregate enforces a k-anonymity floor.
/// Retention: raw events pruned at ~13 months so year-over-year seasonality
/// survives; aggregates kept forever.
model FoodDemandEvent {
  id   String          @id @default(cuid())
  kind DemandEventKind

  userIdHash String?    @map("user_id_hash")
  area       RegionKey?

  /// SEARCH only. `queryNormalized` is lowercased/unaccented/trimmed — it is the
  /// column the unmet-demand insight actually groups by. Zero-result searches
  /// (`resultCount = 0`) are the single most valuable signal in the system.
  query           String?
  queryNormalized String? @map("query_normalized")
  resultCount     Int?    @map("result_count")

  listingId    String? @map("listing_id")
  sellerId     String? @map("seller_id")
  categorySlug String? @map("category_slug")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([queryNormalized, createdAt])
  @@index([area, kind, createdAt])
  @@index([listingId, kind, createdAt])
  @@index([sellerId, kind, createdAt])
  @@map("food_demand_events")
}
