# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Node
/node_modules/

# Env — everything except the checked-in example
.env*
!.env.example

# Filesystem media storage — never committed (architecture Part C/G). This rule
# lands in Slice 1 rather than Slice 4 on purpose: portal-web's repo was missing
# it and the gap was only caught after uploads already existed on disk.
/uploads/

# Seed photo cache (Slice 8) — the pinned manifest is committed, the source
# photography it points at is not.
/seed-assets/

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Deployment runbook — kept local only, filled in with real VPS values as it is
# used, never pushed (same convention as Salon and Apparel)
DEPLOYMENT.md
